# ==============================================
# FRONTEND ENVIRONMENT CONFIGURATION
# ==============================================
# Copy this file to .env and fill in your values
# Vite requires variables to be prefixed with VITE_
# DO NOT commit .env to version control
# ==============================================

# ----------------------------------------------
# API Configuration
# ----------------------------------------------
# Backend API base URL
VITE_API_URL=http://localhost:4000/api

# ----------------------------------------------
# AWS S3 Configuration
# ----------------------------------------------
# For direct file uploads from frontend
# Standard AWS S3
VITE_AWS_REGION=us-east-1
VITE_AWS_ACCESS_KEY_ID=your-aws-access-key-id
VITE_AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
VITE_AWS_BUCKET_NAME=your-bucket-name

# For S3-compatible services (Supabase, MinIO, etc.)
# Uncomment and set your custom endpoint
# VITE_AWS_ENDPOINT=https://your-project.storage.supabase.co

# Public URL for accessing uploaded files
# Supabase format: https://PROJECT.storage.supabase.co/storage/v1/object/public/BUCKET
# AWS format: https://BUCKET.s3.REGION.amazonaws.com
VITE_S3_PUBLIC_URL=https://your-bucket.s3.us-east-1.amazonaws.com

# ----------------------------------------------
# Application Configuration (Optional)
# ----------------------------------------------
# VITE_APP_NAME=PropTech Maintenance
# VITE_APP_VERSION=1.0.0
# VITE_ENABLE_ANALYTICS=false

# ----------------------------------------------
# Feature Flags (Optional)
# ----------------------------------------------
# VITE_ENABLE_NOTIFICATIONS=true
# VITE_ENABLE_FILE_UPLOAD=true
# VITE_MAX_FILE_SIZE=5242880

# ----------------------------------------------
# Development (Optional)
# ----------------------------------------------
# VITE_DEV_PORT=3000
# VITE_DEV_HOST=localhost
